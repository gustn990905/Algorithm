import java.util.Scanner;

public class Main {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int N = sc.nextInt();

        int[] x = new int[N];
        int[] y = new int[N];

        for (int i = 0; i < N; i++) {
            x[i] = sc.nextInt();
            y[i] = sc.nextInt();
        }

        int answer = Integer.MAX_VALUE;

        for (int lineX = 0; lineX <= 100; lineX += 2) {
            for (int lineY = 0; lineY <= 100; lineY += 2) {

                int q1 = 0;
                int q2 = 0;
                int q3 = 0;
                int q4 = 0;

                for (int i = 0; i < N; i++) {

                    if (x[i] > lineX && y[i] > lineY)
                        q1++;
                    else if (x[i] < lineX && y[i] > lineY)
                        q2++;
                    else if (x[i] < lineX && y[i] < lineY)
                        q3++;
                    else
                        q4++;
                }

                int maxCnt = Math.max(
                        Math.max(q1, q2),
                        Math.max(q3, q4)
                );

                answer = Math.min(answer, maxCnt);
            }
        }

        System.out.println(answer);
    }
}

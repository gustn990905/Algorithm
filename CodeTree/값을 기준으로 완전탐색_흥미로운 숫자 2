import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
    	Scanner sc = new Scanner(System.in);
    	
    	int X = sc.nextInt();
    	int Y = sc.nextInt();
    	
    	int result = 0;
    	for(int i=X; i<=Y; i++) {
    		if(check(i)) result++;
    	}
    	
    	System.out.println(result);
    }
    
    static boolean check(int n) {
    	String num = String.valueOf(n);
    	
    	int[] cnt = new int[10];
    	
    	for(int i = 0; i < num.length(); i++) {
            cnt[num.charAt(i) - '0']++;
        }

        int one = 0;      // 1번 나온 숫자 종류 수
        int lenMinus1 = 0; // (길이-1)번 나온 숫자 종류 수

        for(int i = 0; i < 10; i++) {
            if(cnt[i] == 1) one++;
            if(cnt[i] == num.length() - 1) lenMinus1++;
        }

        return one == 1 && lenMinus1 == 1;
    }
}

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int N = sc.nextInt(); // N명의 사람들
		int K = sc.nextInt(); // 사진의 크기
		
		String[] location = new String[10001];
		
		for(int n=0; n<N; n++) {
			int loc = sc.nextInt();
			String alpha = sc.next();
			
			location[loc] = alpha;
		}
		
		int maxScore = 0;
		for(int i=0; i<=10000-K; i++) {
			
			int score = 0;
			for(int j=i; j<=i+K; j++) {
				if(location[j] == null) continue;
				
				if(location[j].equals("G")) score += 1;
				else if(location[j].equals("H")) score += 2;
			}
			
			maxScore = Math.max(maxScore, score);
		}
		
		System.out.println(maxScore);
	}
}

import java.util.Scanner;

public class Main {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int N = sc.nextInt();
		String line = sc.next();
		
		int cnt = 0;
		
		for(int i=0; i<N-2; i++) {
			if(line.charAt(i) == 'C') {
				for(int j=i+1; j<N-1; j++) {
					if(line.charAt(j) == 'O') {
						for(int k=j+1; k<N; k++) {
							if(line.charAt(k) == 'W') cnt++;
						}
					}
				}
			}
		}
		
		System.out.println(cnt);
	}
}

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
    	Scanner sc = new Scanner(System.in);
    	
    	int N = sc.nextInt();
    	int[] H = new int[N];
    	
    	int maxH = 0;
    	for(int h=0; h<N; h++) {
    		H[h] = sc.nextInt();
    		maxH = Math.max(maxH, H[h]);
    	}
    	
    	int result = 0;
    	for(int i=0; i<=maxH; i++) {
    		int cnt = 0;
    		for(int h=0; h<N; h++) {
    			if(H[h] > i) {
    				if(h==0 || H[h-1] <= i) cnt++;
    			}
    		}
    		result = Math.max(result, cnt);
    	}
    	System.out.println(result);
    }
}

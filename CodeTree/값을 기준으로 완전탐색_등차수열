import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
    	Scanner sc = new Scanner(System.in);
    	
    	int N = sc.nextInt();
    	int[] arr = new int[N];
    	for(int n=0; n<N; n++) {
    		arr[n] = sc.nextInt();
    	}
    	
    	int max = 0;
    	for(int K=1; K<200; K++) {
    		int cnt = 0;
    		for(int i=0; i<N-1; i++) {
    			for(int j=i+1; j<N; j++) {
    				if(Math.abs(arr[i]-K) == Math.abs(arr[j]-K)) cnt++;
    			}
    		}
    		
    		max = Math.max(max, cnt);
    	}
    	
    	System.out.println(max);
    }
}

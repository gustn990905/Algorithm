import java.util.Scanner;

public class Main {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int N = sc.nextInt();
		int[] arr = new int[N];
		
		for(int n=0; n<N; n++) {
			arr[n] = sc.nextInt();
		}
		
		int maxNum = -1; // 모든 수에서 carry가 발생하면 기본값인 -1출력
		
		for(int i=0; i<N-2; i++) {
			for(int j=i+1; j<N-1; j++) {
				for(int k=j+1; k<N; k++) {
					int a = arr[i];
					int b = arr[j];
					int c = arr[k];
					
					boolean possible = true; // carry가 발생하는지 확인
					
					// 숫자 3개가 모두 0이 되면 종료
					while(a > 0 || b > 0 || c > 0) {
						int cnt = 0; // 자리수 합 저장
						
						cnt += a%10 + b%10 + c%10;
						
						a /= 10;
						b /= 10;
						c /= 10;
						
						if(cnt >= 10) {
							possible = false;
							break;
						}
					}
					
					if(possible) maxNum = Math.max(maxNum, arr[i]+arr[j]+arr[k]);
				}
			}
		}
		
		System.out.println(maxNum);
	}
}

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int N = sc.nextInt();
		int K = sc.nextInt();
		
		int[] arr = new int[N];
		
		for(int n=0; n<N; n++) {
			arr[n] = sc.nextInt();
		}
		
		int maxResult = 0;
		
		for(int i=0; i<=N-K; i++) {
			int sum = 0;
			for(int j=i; j<i+K; j++) {
				sum += arr[j];
			}
			maxResult = Math.max(maxResult, sum);
		}
		
		System.out.println(maxResult);
	}
}

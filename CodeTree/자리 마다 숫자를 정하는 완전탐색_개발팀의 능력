import java.util.Scanner;

public class Main {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);

		int[] people = new int[5];

		int teamSum = 0;
		for (int p = 0; p < 5; p++) {
			people[p] = sc.nextInt();
			teamSum += people[p];
		}

		int result = Integer.MAX_VALUE;
		for (int i = 0; i < 5; i++) {
			for (int j = i + 1; j < 5; j++) {
				boolean[] used = new boolean[5];
				used[i] = true;
				used[j] = true;

				for (int k = 0; k < 5; k++) {
					if (used[k])
						continue;
					for (int l = k + 1; l < 5; l++) {
						if (used[l])
							continue;

						int team1 = people[i] + people[j];
						int team2 = people[k] + people[l];
						int team3 = teamSum - team1 - team2;
						
						if(team1 != team2 && team2 != team3 && team1 != team3) {
							int max = Math.max(team1, Math.max(team2, team3));
							int min = Math.min(team1, Math.min(team2, team3));
							
							result = Math.min(result, max-min);
						}
					}
				}
			}
		}
		if(result == Integer.MAX_VALUE) System.out.println(-1);
		else System.out.println(result);
	}
}

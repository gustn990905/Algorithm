import java.util.Scanner;

public class Main {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);

		int N = sc.nextInt();
		
		int[][] spot = new int[N][2];
		
		for(int n=0; n<N; n++) {
			spot[n][0] = sc.nextInt();
			spot[n][1] = sc.nextInt();
		}
		
		int result = Integer.MAX_VALUE;
		// 제외할 점 고르기
		for(int i=0; i<N; i++) {
			
			int maxX = 0;
			int minX = Integer.MAX_VALUE;
			int maxY = 0;
			int minY = Integer.MAX_VALUE;
			
			for(int j=0; j<N; j++) {
				// 제외할 점과 idx 값이 같으면 continue
				if(i == j) continue;
				
				maxX = Math.max(maxX, spot[j][0]);
				minX = Math.min(minX, spot[j][0]);
				maxY = Math.max(maxY, spot[j][1]);
				minY = Math.min(minY, spot[j][1]);
			}
			
			result = Math.min(result, (maxX-minX)*(maxY-minY));
		}
		System.out.println(result);
	}
}

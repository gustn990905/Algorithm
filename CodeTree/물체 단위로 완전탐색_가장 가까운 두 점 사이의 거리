import java.util.Scanner;

public class Main {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);

		int N = sc.nextInt();
		
		int[][] arr = new int[N][2];
		for(int n=0; n<N; n++) {
			arr[n][0] = sc.nextInt();
			arr[n][1] = sc.nextInt();
		}
		
		int result = Integer.MAX_VALUE;
		for(int i=0; i<N-1; i++) {
			for(int j=i+1; j<N; j++) {
				int cal = (arr[i][0] - arr[j][0])*(arr[i][0] - arr[j][0]) +
						(arr[i][1] - arr[j][1])*(arr[i][1] - arr[j][1]);
				
				result = Math.min(result, cal);
			}
		}
		
		System.out.println(result);
	}
}

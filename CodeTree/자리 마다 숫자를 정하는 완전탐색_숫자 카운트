import java.util.Scanner;

public class Main {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);

		int N = sc.nextInt();

		int[][] arr = new int[N][3];

		for (int n = 0; n < N; n++) {
			arr[n][0] = sc.nextInt();
			arr[n][1] = sc.nextInt();
			arr[n][2] = sc.nextInt();
		}
		
		int ans = 0;
		
		for(int a=1; a<=9; a++) {
			for(int b=1; b<=9; b++) {
				if(a == b) continue; // 모든 자리의 수가 달라야 함
				
				for(int c=1; c<=9; c++) {
					if(a == c || b == c) continue;
					
					boolean possible = true;
					
					for(int i=0; i<N; i++) {
						int num = arr[i][0];
						
						int x = num / 100;
						int y = (num / 10) % 10;
						int z = num % 10;
						
						int cnt1 = 0;
						int cnt2 = 0;
						
						// cnt1 계산
						if(a == x) cnt1++;
						if(b == y) cnt1++;
						if(c == z) cnt1++;
						
						// cnt2 계산
						if(a == y || a == z) cnt2++;
						if(b == x || b == z) cnt2++;
						if(c == x || c == y) cnt2++;
						
						if(cnt1 != arr[i][1] || cnt2 != arr[i][2]) {
							possible = false;
							break;
						}
					}
					if(possible) ans++;
 				}
			}
		}
		
		System.out.println(ans);
	}
}

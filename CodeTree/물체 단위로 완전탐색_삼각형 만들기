import java.util.Scanner;

public class Main {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);

		int N = sc.nextInt();
		
		int[][] arr = new int[N][2];
		
		for(int i=0; i<N; i++) {
			arr[i][0] = sc.nextInt();
			arr[i][1] = sc.nextInt();
 		}
		
		int maxResult = 0;
		for(int i=0; i<N-2; i++) {
			for(int j=i+1; j<N-1; j++) {
				for(int k=j+1; k<N; k++) {
					int tri = 0;
					if(arr[i][0] == arr[j][0] && arr[j][1]==arr[k][1]) {
						tri = Math.abs(arr[j][1] - arr[i][1]) * Math.abs(arr[k][0] - arr[j][0]);
					}
					else if(arr[k][0] == arr[j][0] && arr[j][1]==arr[i][1]) {
						tri = Math.abs(arr[j][0] - arr[i][0]) * Math.abs(arr[k][1] - arr[j][1]);
					}
					else if(arr[k][0] == arr[i][0] && arr[i][1]==arr[j][1]) {
						tri = Math.abs(arr[i][0] - arr[j][0]) * Math.abs(arr[k][1] - arr[i][1]);
					}
					else if(arr[j][0] == arr[i][0] && arr[i][1]==arr[k][1]) {
						tri = Math.abs(arr[i][0] - arr[k][0]) * Math.abs(arr[j][1] - arr[i][1]);
					}
					else if(arr[j][0] == arr[k][0] && arr[k][1]==arr[i][1]) {
						tri = Math.abs(arr[i][0] - arr[k][0]) * Math.abs(arr[j][1] - arr[k][1]);
					}
					else if(arr[i][0] == arr[k][0] && arr[k][1]==arr[j][1]) {
						tri = Math.abs(arr[k][0] - arr[j][0]) * Math.abs(arr[k][1] - arr[i][1]);
					}
					
					maxResult = Math.max(maxResult, tri);
				}
			}
		}
		System.out.println(maxResult);
	}
}

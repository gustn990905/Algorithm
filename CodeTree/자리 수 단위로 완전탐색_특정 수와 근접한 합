import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int N = sc.nextInt();
		int S = sc.nextInt();
		
		int[] arr = new int[N];
		for(int n=0; n<N; n++) {
			arr[n] = sc.nextInt();
		}
		
		int minResult = Integer.MAX_VALUE;
		
		for(int a=0; a<N-1; a++) {
			for(int b=a+1; b<N; b++) {
				
				int T = 0; // 숫자들의 합
				for(int i=0; i<N; i++) {
					if(i == a || i == b) continue;
					
					T += arr[i];
				}
				
				minResult = Math.min(minResult, Math.abs(S-T));
			}
		}
		
		System.out.println(minResult);
	}
}

import java.util.Scanner;

public class Main {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int N = sc.nextInt();
		
		int[] arr = new int[N];
		
		for(int n=0; n<N; n++) {
			arr[n] = sc.nextInt();
		}
		
		int maxResult = 0;
		for(int i=0; i<N-2; i++) {
			for(int j=i+2; j<N; j++) {
				int result = arr[i] + arr[j];
				maxResult = Math.max(maxResult, result);
			}
		}
		
		System.out.println(maxResult);
	}
}

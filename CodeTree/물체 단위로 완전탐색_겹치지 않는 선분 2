import java.util.Scanner;

public class Main {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);

		int N = sc.nextInt();
		
		int[] x1 = new int[N];
		int[] x2 = new int[N];
		
		for(int i=0; i<N; i++) {
			x1[i] = sc.nextInt();
			x2[i] = sc.nextInt();
		}
		
		boolean[] cross = new boolean[N];
		
		for(int i=0; i<N; i++) {
			for(int j=i+1; j<N; j++) {
				if((x1[i] - x1[j]) * (x2[i] - x2[j]) < 0) {
					cross[i] = true;
					cross[j] = true;
				}
			}
		}
		
		int result = 0;
		for(int i=0; i<N; i++) {
			if(!cross[i]) result++;
		}
		
		System.out.println(result);
	}
}

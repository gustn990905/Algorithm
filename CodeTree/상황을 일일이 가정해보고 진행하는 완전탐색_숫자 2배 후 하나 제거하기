import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int N = sc.nextInt();
        int[] arr = new int[N];
        for(int n=0; n<N; n++) {
        	arr[n] = sc.nextInt();
        }
        
        int result = Integer.MAX_VALUE;
        // 2배 할 숫자 고르기
        for(int i=0; i<N; i++) {
        	int num = arr[i];
        	arr[i] = num*2;	
        	
        	// 제거할 숫자 고르기
        	for(int j=0; j<N; j++) {
        		// 이미 두 배를 한 숫자는 제외
        		if(i == j) continue;
        		
        		int num2 = arr[j];
        		arr[j] = 0;
        		
        		int cal = 0;
        		for(int k=0; k<N-1; k++) {
        			// 제거된 값 건너뛰기
        			if(k == j) continue;
        			
        			int a = arr[k];
        			int next = k + 1;

        		    if(next == j) {
        		        next++;
        		    }

        		    if(next >= N) continue;

        		    int b = arr[next];

        		    cal += Math.abs(a - b);
        		}
        		
        		result = Math.min(result, cal);
        		
        		// 제거한 숫자 되돌리기
        		arr[j] = num2;
        	}
        	
        	// 두 배한 숫자 되돌리기
        	arr[i] = num;
        }
        System.out.println(result);
    }
}

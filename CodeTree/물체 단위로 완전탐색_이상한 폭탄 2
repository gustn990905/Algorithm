import java.util.Scanner;

public class Main {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int N = sc.nextInt(); // 폭탄의 개수
		int K = sc.nextInt(); // 폭발 가능한 거리
		
		int[] bombs = new int[N];
		for(int i=0; i<N; i++) {
			bombs[i] = sc.nextInt();
		}
		
		int max = 0;
		for(int i=0; i<N; i++) {
			int bomb = 0;
			for(int j=i-K; j<=i+K; j++) {
				// 범위를 벗어나면 continue
				if(j<0 || j>=N) continue;
				
				// 같은 idx면 continue
				if(i == j) continue;
				
				// 같은 폭탄이 있으면 터짐
				if(bombs[i] == bombs[j]) bomb = bombs[i];
			}
			
			max = Math.max(max, bomb);
		}
		
		if(max == 0) System.out.println(-1);
		else System.out.println(max);
	}
}
